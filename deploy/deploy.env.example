# Copy to deploy/deploy.env (git-ignored) and edit.  Used by tools/deploy.sh.
DOMAIN=office.example.com

# Where your nginx reads vhosts from, and how to test/reload it (a containerised nginx is fine).
NGINX_CONF_DIR=/etc/nginx/conf.d
NGINX_TEST_CMD="sudo nginx -t"
NGINX_RELOAD_CMD="sudo nginx -s reload"

# Address nginx uses to reach the office (host nginx: 127.0.0.1; docker nginx: host.docker.internal).
UPSTREAM=127.0.0.1:4747

# TLS certificate paths *as nginx sees them* (e.g. a Cloudflare origin cert, or Let's Encrypt).
SSL_CERT=/etc/ssl/certs/office.pem
SSL_KEY=/etc/ssl/private/office.key

# SKIP_NGINX=1     only install the systemd user service
