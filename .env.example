# You normally do not need to touch this: `npm start` creates .env from this template with a fresh token.
# Never commit .env.
# The office can type into your terminals, so it refuses to start without a token.
# Generate one:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
OFFICE_TOKEN=change-me-to-a-long-random-string

PORT=4747
# Comma-separated bind addresses. Default: loopback only (add 172.17.0.1 for a dockerised nginx).
# HOST=127.0.0.1
# Use a named herdr session instead of the default one:
# HERDR_SESSION=default
# HERDR_SOCKET_PATH=/path/to/herdr.sock
